[Unit]
Description=ducktainer - PAM credential check
CollectMode=inactive-or-failed

[Service]
Type=simple
# Root only for the duration of one login attempt: reads one request from
# the socket, runs the PAM "ducktainer" stack, answers and exits.
ExecStart=/usr/bin/ducktainer pam-helper --service ducktainer
StandardInput=socket
StandardOutput=socket
StandardError=journal
User=root
RuntimeMaxSec=60
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
