[Unit]
Description=dockera - system credential check (socket)
PartOf=dockera.service

[Socket]
# Only the dockera group (the service user) may ask for password checks.
ListenStream=/run/dockera/pam.sock
SocketUser=root
SocketGroup=dockera
SocketMode=0660
DirectoryMode=0755
Accept=yes
MaxConnections=16

[Install]
WantedBy=sockets.target
