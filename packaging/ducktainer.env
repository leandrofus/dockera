# `ducktainer serve` options (see `ducktainer help`). After editing:
#   systemctl restart ducktainer
#
# By default it only listens on 127.0.0.1:9900. To open it to the network,
# allow hosts (also with `ducktainer allow add …`):
#   DUCKTAINER_OPTS="--allow 192.168.1.0/24"
# Also expose the Docker API to other ducktainer instances:
#   DUCKTAINER_OPTS="--allow 10.0.0.0/8 --expose :2376"
DUCKTAINER_OPTS=""
