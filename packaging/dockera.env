# `dockera serve` options (see `dockera help`). After editing:
#   systemctl restart dockera
#
# By default it only listens on 127.0.0.1:9900. To open it to the network,
# allow hosts (also with `dockera allow add …`):
#   DOCKERA_OPTS="--allow 192.168.1.0/24"
# Also expose the Docker API to other dockera instances:
#   DOCKERA_OPTS="--allow 10.0.0.0/8 --expose :2376"
DOCKERA_OPTS=""
