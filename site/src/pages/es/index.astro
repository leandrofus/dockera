---
import Base from '../../layouts/Base.astro'
import Home from '../../components/Home.astro'
import { LANGS, strings, type Lang } from '../../i18n'
import { latestRelease } from '../../release'
import { homePath } from '../../paths'

const release = await latestRelease()
const alternates = Object.fromEntries(LANGS.map((l) => [l, homePath(l)])) as Record<Lang, string>
---
<Base lang="es" title={strings.es.title} description={strings.es.description} alternates={alternates}>
  <Home lang="es" release={release} />
</Base>
